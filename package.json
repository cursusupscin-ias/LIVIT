{
  "name": "livit",
  "version": "1.0.0",
  "private": true,
  "description": "LIVIT personal life list",
  "scripts": {
    "copy:web": "node scripts/copy-web.js",
    "build:native-auth": "esbuild scripts/native-auth.js --bundle --format=esm --platform=browser --target=es2020 --outfile=www/native-auth.js",
    "build:web": "npm run copy:web && npm run build:native-auth",
    "android:sync": "npm run build:web && cap sync android && node scripts/configure-android.mjs && capacitor-assets generate --android",
    "verify:android": "node scripts/verify-android.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2",
    "@capacitor-firebase/authentication": "8.6.0",
    "firebase": "12.6.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/cli": "8.6.2",
    "@capacitor/assets": "4.0.0",
    "esbuild": "0.28.2"
  }
}
